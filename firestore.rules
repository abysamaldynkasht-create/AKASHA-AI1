rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "akashaai249@gmail.com";
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUserProfile(data) {
      return data.get('uid', '') == request.auth.uid && 
             data.get('email', '') is string &&
             data.get('createdAt', '') is string;
    }

    function isValidChatSession(data, userId) {
      return data.get('userId', '') == userId && 
             data.get('userId', '') == request.auth.uid &&
             data.get('title', '') is string &&
             data.get('createdAt', '') is string &&
             data.get('updatedAt', '') is string;
    }

    function isValidChatMessage(data) {
      return data.get('sessionId', '') is string &&
             (data.get('role', '') == 'user' || data.get('role', '') == 'assistant') && 
             data.get('content', '') is string &&
             data.get('createdAt', '') is string;
    }

    function isValidUserMemory(data) {
      return data.get('content', '') is string && 
             data.get('content', '').size() <= 10000 &&
             data.get('updatedAt', '') is string;
    }

    function isValidUserAISettings(data) {
      return data.get('provider', '') is string && 
             (data.get('provider', '') == 'gemini' || data.get('provider', '') == 'openrouter' || data.get('provider', '') == 'groq') &&
             data.get('model', '') is string &&
             data.get('apiKey', '') is string &&
             data.get('apiKey', '').size() <= 1000 &&
             data.get('systemInstruction', '') is string &&
             data.get('systemInstruction', '').size() <= 10000 &&
             data.get('updatedAt', '') is string;
    }

    // ===============================================================
    // Client and Subcollection Access Controls
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);

      match /config/memory {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidUserMemory(request.resource.data);
      }

      match /config/ai {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidUserAISettings(request.resource.data);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChatSession(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidChatSession(request.resource.data, userId);
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && isValidChatMessage(request.resource.data);
          allow update: if isOwner(userId) && isValidChatMessage(request.resource.data);
          allow delete: if isOwner(userId);
        }
      }

      match /feedback/{feedbackId} {
        allow read, create: if isOwner(userId);
      }
    }

    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
